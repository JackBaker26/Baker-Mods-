PBStuff::POKEMONTOCREST[:ELECTIVIRE] = :EVIRECREST


ModCacheInjection.hook(:items) {
  $cache.items[:EVIRECREST] = ItemData.new(:EVIRECREST, {
    name: "Electivire Crest",
    desc: "Electivire's Spatk and Speed equals it's Atk. Boosts Punch attacks by 20%.",
    price: 0,
    crest: true,
    noUseInBattle: true,
    noUse: true,
  })
}

class PokeBattle_Battler
    alias virecrest_crestStats crestStats if !defined?(virecrest_crestStats)
    def crestStats
      virecrest_crestStats
      case @crested
        when :ELECTIVIRE
            @speed = @attack
            @spatk = @attack
            
      end
     
    end
   

end

class PokeBattle_Move
  alias_method :virecrest_punch, :pbBaseDamageMultiplier unless method_defined?(:virecrest_punch)
  def pbBaseDamageMultiplier(damagemult, attacker, opponent)
    damagemult = virecrest_punch(damagemult, attacker, opponent)
    damagemult *= 1.2 if attacker.crested == :ELECTIVIRE && punchMove?
    return damagemult
  end
end
