PBStuff::POKEMONTOCREST[:PORYGONZ] = :PORYGONZCREST


ModCacheInjection.hook(:items) {
  $cache.items[:PORYGONZCREST] = ItemData.new(:PORYGONZCREST, {
    name: "Porygon-Z Crest",
    desc: "Porygon's type become's glitched and it's speed is boosted by 30%",
    price: 0,
    crest: true,
    noUseInBattle: true,
    noUse: true,
  })
}

class PokeBattle_Battler
    alias porygonzcrest_crestStats crestStats if !defined?(porygonzcrest_crestStats)
    def crestStats
      porygonzcrest_crestStats
      case @crested
        when :PORYGONZ
            @speed *= 1.3
            @type = :QMARKS
            
            
      end
     
    end
   
end


